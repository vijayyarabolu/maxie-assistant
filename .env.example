# Optional. Maxie keeps its settings and keys in ~/.maxie (set them in the web Settings page).
# A variable set here or in your shell wins over ~/.maxie/secrets.json, which is handy for CI or a
# throwaway hub. Never commit a real .env.
ANTHROPIC_API_KEY=
# MAXIE_DATA=~/.maxie          # where settings, keys, the database and backups live
# HUB_PORT=8780
# LAYA_API_KEY=                # only if you run the optional local router (make laya)
