<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rotates ~/Library/Logs/maxie/*.log daily at 03:30 (deploy/rotate_logs.sh, copy-truncate, keeps 7). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.maxie.logrotate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec sh "$HOME/Library/Logs/maxie/rotate_logs.sh"</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardErrorPath</key><string>__LOGS__/logrotate.err.log</string>
</dict>
</plist>
